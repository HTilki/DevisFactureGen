# Modèle de configuration à copier dans `.streamlit/secrets.toml` (non versionné).
# Toutes les valeurs ci-dessous sont fictives : remplacez-les par les vôtres.

entreprise_nom = "NOM DE L'ENTREPRISE"
entreprise_adresse_rue = "1 rue de l'Exemple"
entreprise_adresse_code_postale = "00000"
entreprise_adresse_ville = "MA VILLE"
entreprise_email = "contact@exemple.fr"
entreprise_telephone = "0600000000"
entreprise_siret = "000 000 000 00000"
entreprise_ape = "0000X"

assurance_nom = "NOM DE L'ASSUREUR"
assurance_adresse_rue = "1 chemin de l'Exemple"
assurance_adresse_code_postale = "00000"
assurance_adresse_ville = "VILLE DE L'ASSUREUR"
assurance_couverture_geographique = "France"

# Commune pré-remplie dans le « Fait à … » du certificat de cession (optionnel).
ville_par_defaut = "MA VILLE"

# Mot de passe de la page de connexion (optionnel : la page est désactivée par défaut).
# password = "..."

# --- Profils vendeurs -------------------------------------------------------
# Utilisés pour pré-remplir le bloc « ancien propriétaire » du certificat de cession.
# Un profil = une section [vendeur_profiles.<identifiant>]. Toutes les clés sont
# facultatives : celles qui sont absentes n'écrasent pas la saisie manuelle.

[vendeur_profiles.exemple_morale]
label = "Ma société (personne morale)"
type_personne = "morale"          # "physique" ou "morale"
raison_sociale = "MA SOCIETE"
siret = "00000000000000"
voie_numero = "1"
voie_extension = ""               # BIS, TER...
voie_type = "RUE"
voie_nom = "DE L'EXEMPLE"
code_postal = "00000"
commune = "MA VILLE"
fait_a = "Ma Ville"               # pré-remplit le « Fait à » de la signature

[vendeur_profiles.exemple_physique]
label = "Jean Dupont (personne physique)"
type_personne = "physique"
sexe = "M"                        # "M" ou "F"
nom = "DUPONT"
nom_usage = ""
prenom = "Jean"
siret = ""
voie_numero = "2"
voie_type = "PLACE"
voie_nom = "DE L'EXEMPLE"
code_postal = "00000"
commune = "MA VILLE"
fait_a = "Ma Ville"
